# Database connection string
DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Google Docs (Service Account)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_FOLDER_ID=

# Contact Form (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
CONTACT_FORM_TO_EMAIL=your-email@gmail.com
CONTACT_FORM_FROM_EMAIL=contact@yourdomain.com
CONTACT_FORM_FROM_NAME=Your Name - Contact Form
# Optional: Multiple recipients (comma-separated)
CONTACT_FORM_CC_EMAILS=backup@gmail.com,team@company.com

# Booking Notifications (Resend — reuses RESEND_API_KEY above)
# Email address that receives new booking + payment alerts (defaults to CONTACT_FORM_TO_EMAIL if unset)
BOOKING_NOTIFICATION_EMAIL=your-email@gmail.com

# Booking System (Stripe)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Booking Configuration
NEXT_PUBLIC_BOOKING_ENABLED=true
BOOKING_TIMEZONE=Asia/Manila
BOOKING_BUFFER_MINUTES=15
BOOKING_CONFIRMATION_HOURS=24
BOOKING_ADVANCE_NOTICE_DAYS=7
BOOKING_PAYOUT_MODE=manual

# Lighthouse Performance Badge (optional)
# Powers the live "Lighthouse N ↗" badge in the homepage CredibilityStrip.
# Without a key, the public PageSpeed Insights API is used (25k requests/day,
# more than enough thanks to 24h ISR caching). Set a key to lift that quota.
# Get one at https://console.cloud.google.com/apis/credentials → enable
# "PageSpeed Insights API" → create API Key.
PAGESPEED_API_KEY=
