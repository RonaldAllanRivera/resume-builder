# Database connection string
# For production (Vercel Postgres / Neon / Supabase / etc.) append
# `?sslmode=verify-full` to keep strict cert verification — required to avoid
# silently weaker SSL semantics in the upcoming pg v9.
#   Example: postgresql://USER:PASS@host.neon.tech/db?sslmode=verify-full
DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel Blob — REQUIRED in production for Media uploads to persist.
# Without this, uploads on Vercel succeed in the admin UI but vanish on
# the next deploy (Vercel filesystem is ephemeral). Provisioning:
#   Vercel dashboard → Project → Storage → Create Database → Blob.
# The token is auto-injected into your project env vars.
# Locally without a token, uploads fall back to public/media on disk.
BLOB_READ_WRITE_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Google Docs (Service Account)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_FOLDER_ID=

# Contact Form (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
CONTACT_FORM_TO_EMAIL=your-email@gmail.com
CONTACT_FORM_FROM_EMAIL=contact@yourdomain.com
CONTACT_FORM_FROM_NAME=Your Name - Contact Form
# Optional: Multiple recipients (comma-separated)
CONTACT_FORM_CC_EMAILS=backup@gmail.com,team@company.com

# Booking Notifications (Resend — reuses RESEND_API_KEY above)
# Email address that receives new booking + payment alerts (defaults to CONTACT_FORM_TO_EMAIL if unset)
BOOKING_NOTIFICATION_EMAIL=your-email@gmail.com

# Booking Configuration
# Buffer minutes, advance-notice days, and deposit/payment-deadline timing are configured on the
# AvailabilityRules collection, Packages.advanceNoticeDays, and the bookingSettings global — not env vars.
BOOKING_TIMEZONE=Asia/Manila

# Claude vision — payment-receipt OCR (src/lib/receipt-ocr.ts)
ANTHROPIC_API_KEY=sk-ant-...

# Lighthouse Performance Badge (PageSpeed Insights API)
# Powers the live "Lighthouse N ↗" badge in the homepage CredibilityStrip.
# - PAGESPEED_API_KEY: strongly recommended in production. The public quota is
#   tightly burst-limited and frequently returns 429 without a key. Free key:
#   https://console.cloud.google.com/apis/credentials → enable "PageSpeed
#   Insights API" → create API Key. Restrict by API to PageSpeed Insights
#   only (Application restrictions: None — used server-side from Vercel).
# - LIGHTHOUSE_AUDIT_URL: optional override. Defaults to NEXT_PUBLIC_SERVER_URL.
#   Use this in local dev to point the audit at the production domain
#   (e.g. https://www.allanai.dev) so the badge renders during development —
#   localhost / 127.0.0.1 / *.vercel.app are auto-skipped.
PAGESPEED_API_KEY=
LIGHTHOUSE_AUDIT_URL=
