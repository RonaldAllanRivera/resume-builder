# Test Environment Variables
# This file is used for running tests with an isolated test database

# Test Database (separate from development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/payload_test

# Payload
PAYLOAD_SECRET=test-secret-key-change-in-production
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Disable external services in tests
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_FOLDER_ID=

# OpenAI (use test key or mock)
OPENAI_API_KEY=sk-test-mock-key

# Vercel Blob (disable in tests)
BLOB_READ_WRITE_TOKEN=

# Node Environment
NODE_ENV=test
