# Test Environment Variables
# This file is used for running tests with an isolated test database

# Test Database (separate from development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/payload_test

# Payload
PAYLOAD_SECRET=test-secret-key-change-in-production
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Disable external services in tests
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_FOLDER_ID=

# OpenAI (use test key or mock)
OPENAI_API_KEY=sk-test-mock-key

# Vercel Blob (disable in tests)
BLOB_READ_WRITE_TOKEN=

# Resend — MUST stay present and empty, do not delete this line.
# vitest.setup.ts runs `import 'dotenv/config'`, which loads .env to fill any
# gap left by this file. If this key were merely absent, that backfill would
# supply the REAL production key and the booking suites — which call the actual
# POST /api/bookings handler — would send live email on every run. Declaring it
# empty occupies the slot (dotenv skips keys already present in process.env),
# so src/lib/booking-email.ts takes its `RESEND_API_KEY not set` skip path.
RESEND_API_KEY=

# Test user password (for integration tests)
TEST_USER_PASSWORD=secure-test-password-2026

# Node Environment
NODE_ENV=test
