# Database connection string=
DATABASE_URL=
# Or use a PG connection string=
#DATABASE_URL=
# Used to encrypt JWT tokens=
PAYLOAD_SECRET=
# Used to configure CORS, format links and more. No trailing slash=
NEXT_PUBLIC_SERVER_URL=
# Secret used to authenticate cron jobs=
CRON_SECRET=
# Used to validate preview requests=
PREVIEW_SECRET=
# Added by Payload=
# Vercel Blob=
BLOB_READ_WRITE_TOKEN=
# OpenAI=
OPENAI_API_KEY=
# Google OAuth2 (User Credentials - for local Docker testing)=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Google Drive Folder ID (shared folder where documents will be created)=
GOOGLE_DRIVE_FOLDER_ID=
# Test user password (for integration tests)=
TEST_USER_PASSWORD=
# Node Environment=
NODE_ENV=
# Contact Form (Resend)=
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=
CONTACT_FORM_FROM_EMAIL=
CONTACT_FORM_FROM_NAME=
# Optional: Multiple recipients (comma-separated)=
# CONTACT_FORM_CC_EMAILS=
# Booking Notifications (Resend — reuses RESEND_API_KEY above)=
# Email address that receives new booking + payment alerts (defaults to CONTACT_FORM_TO_EMAIL if unset)=
BOOKING_NOTIFICATION_EMAIL=
# Booking System (Stripe)=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Booking Configuration=
NEXT_PUBLIC_BOOKING_ENABLED=
BOOKING_TIMEZONE=
BOOKING_BUFFER_MINUTES=
BOOKING_CONFIRMATION_HOURS=
BOOKING_ADVANCE_NOTICE_DAYS=
BOOKING_PAYOUT_MODE=
# Lighthouse Performance Badge (PageSpeed Insights API)=
# Powers the live "Lighthouse N ↗" badge in the homepage CredibilityStrip.=
# - PAGESPEED_API_KEY: strongly recommended in production. The public quota is=
#   tightly burst-limited and frequently returns 429 without a key. Free key:=
#   https://console.cloud.google.com/apis/credentials → enable "PageSpeed=
#   Insights API" → create API Key. Restrict by API to PageSpeed Insights=
#   only (Application restrictions: None — used server-side from Vercel).=
# - LIGHTHOUSE_AUDIT_URL: optional override. Defaults to NEXT_PUBLIC_SERVER_URL.=
#   Use this in local dev to point the audit at the production domain=
#   (e.g. https://www.allanai.dev) so the badge renders during development —=
#   localhost / 127.0.0.1 / *.vercel.app are auto-skipped.=
PAGESPEED_API_KEY=
LIGHTHOUSE_AUDIT_URL=